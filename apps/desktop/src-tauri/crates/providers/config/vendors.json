{
  "version": 1,
  "vendors": [
    {
      "id": "openrouter",
      "display": "OpenRouter",
      "kind": "openai_compat",
      "base_url": "https://openrouter.ai/api/v1",
      "env": "OPENROUTER_API_KEY",
      "placeholder": "sk-or-…",
      "source": "openrouter.ai/keys",
      "extra_headers": {
        "HTTP-Referer": "https://github.com/truongnat/aix",
        "X-Title": "aix"
      },
      "note": "Meta-provider — one key reaches every vendor's models."
    },
    {
      "id": "anthropic",
      "display": "Anthropic",
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "env": "ANTHROPIC_API_KEY",
      "placeholder": "sk-ant-…",
      "source": "console.anthropic.com"
    },
    {
      "id": "openai",
      "display": "OpenAI",
      "kind": "openai_compat",
      "base_url": "https://api.openai.com/v1",
      "env": "OPENAI_API_KEY",
      "placeholder": "sk-…",
      "source": "platform.openai.com",
      "model_prefixes": [
        "gpt-",
        "o1",
        "o3",
        "o4",
        "chatgpt-"
      ]
    },
    {
      "id": "qwen",
