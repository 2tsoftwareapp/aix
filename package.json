{
  "name": "aix",
  "private": true,
  "version": "0.1.0",
  "description": "aix \u2014 speckit-native AI desktop app (Tauri)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @aix/desktop tauri dev",
    "build": "pnpm --filter @aix/desktop build",
    "lint": "eslint .",
    "test": "pnpm --filter @aix/desktop test:ui-conventions && pnpm --filter @aix/desktop test:regression",
    "desktop:build": "pnpm --filter @aix/desktop tauri build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
