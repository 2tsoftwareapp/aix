{
  "name": "aix-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "aix \u2014 AI Engineering Platform (TypeScript monorepo)",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
